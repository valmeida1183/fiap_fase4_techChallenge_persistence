# .env

# SQL Server Credentials
SQL_SERVER_PASSWORD=fiapUser1234

# Persistence API Connection String
# Note: 'Server=sqlserver' uses the Docker service name, and port 1433 is the internal port for SQL Server.
PERSISTENCE_API_CONNECTION_STRING="Server=sqlserver,1433; Database=Fase4TechChallenge; User Id=sa; Password=${SQL_SERVER_PASSWORD}; TrustServerCertificate=True"